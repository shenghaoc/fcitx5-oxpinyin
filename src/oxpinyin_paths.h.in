#ifndef FCITX5_OXPINYIN_PATHS_H_
#define FCITX5_OXPINYIN_PATHS_H_

/* Compiled-in fallback for the engine's system data directory; the
 * OXPINYIN_SYSTEM_DATA_DIR env override wins at runtime. */
#define OXPINYIN_COMPILED_DATADIR "@ENGINE_SYSTEM_DATA_DIR@"

/* Compiled-in fallback for the English word database; the
 * OXPINYIN_ENGLISH_SYSTEM_DB env override wins at runtime. */
#define OXPINYIN_COMPILED_ENGLISH_DB "@OXPINYIN_ENGLISH_DB_INSTALL_PATH@"

#endif /* FCITX5_OXPINYIN_PATHS_H_ */
